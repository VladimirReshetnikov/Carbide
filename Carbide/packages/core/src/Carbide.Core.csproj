<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>$(NetVersion)</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- M1: disable publish trimming. Trimmed runtime assemblies used as metadata references
         drop BCL methods (e.g. Console.Write) that the user's compilation expects, yielding
         CS0117. M3 restores trimming once @carbide/refs-net10.0 ships untrimmed reference
         assemblies (architecture Q.3). -->
    <IsTrimmable>false</IsTrimmable>
    <PublishTrimmed>false</PublishTrimmed>

    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>

    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <CompressionEnabled>false</CompressionEnabled>
    <!-- WasmBundlerFriendlyBootConfig inlines asset imports into dotnet.js; leaving it off
         lets Node/non-bundler callers fetch _framework/*.dll over http without a patch step. -->
    <WasmBundlerFriendlyBootConfig>false</WasmBundlerFriendlyBootConfig>

    <WasmEnableWebcil>true</WasmEnableWebcil>

    <RootNamespace>Carbide.Core</RootNamespace>
    <AssemblyName>Carbide.Core</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration) == 'Release'">
    <DebuggerSupport>false</DebuggerSupport>
    <UseNativeHttpHandler>true</UseNativeHttpHandler>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jab" Version="0.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.3.0" />
    <!-- Pinned to the 10.0.6 servicing band, matching the Mono-WASM runtime the SDK pin
         fixes, so the vendored upstream notices stay version-accurate. Both this package
         and the Microsoft.Extensions.DependencyInjection.Abstractions it pulls in ship as
         DLLs in _framework, so a published Carbide must not carry preview builds of them. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.6" />
  </ItemGroup>

  <PropertyGroup Condition="$(Configuration) == 'Debug'">
    <WasmNativeStrip>false</WasmNativeStrip>
    <WasmEmitSymbolMap>true</WasmEmitSymbolMap>
    <WasmBuildNative>true</WasmBuildNative>
    <WasmDebugLevel>1</WasmDebugLevel>
    <WasmNativeDebugSymbols>true</WasmNativeDebugSymbols>
  </PropertyGroup>

  <ItemGroup Condition="'$(PublishTrimmed)' == 'True'">
    <TrimmerRootDescriptor Include="roots.xml" />
  </ItemGroup>

  <!-- Directory.Build.props enables IsTrimmable by default; override locally to match the
       settings above. -->
  <PropertyGroup>
    <IsTrimmable>false</IsTrimmable>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="node_modules/**/*" />
    <None Remove="dist/**/*" />
  </ItemGroup>

  <!--
    The SDK's Webcil conversion is incremental on file timestamps: it keeps the converted
    `obj/<config>/<tfm>/webcil/*.wasm` whenever it is newer than the assembly it came from.
    A NuGet package restored months ago carries an old timestamp, so moving a PackageReference
    to a *different* package version leaves the previous version's Webcil in place, and that is
    what gets published — a freshly built Carbide.Core shipped on top of the previous compiler,
    with no error anywhere and no size or name change to notice. The Roslyn 4.14.0 -> 5.6.0 bump
    hit exactly this: the payload still carried 4.14.0 after a full `rm -rf publish/` rebuild,
    because the staleness lives in obj/, not in the output directory.

    Restore rewrites project.assets.json whenever the resolved package graph changes, so use it
    as the invalidation signal and drop the converted output whenever it moves. Steady-state
    builds skip this target, so the full reconversion cost is paid only when it is warranted.
  -->
  <Target Name="CarbideInvalidateWebcilOnPackageGraphChange"
          BeforeTargets="PrepareForBuild"
          Condition="'$(WasmEnableWebcil)' == 'true' And Exists('$(ProjectAssetsFile)')"
          Inputs="$(ProjectAssetsFile)"
          Outputs="$(IntermediateOutputPath)carbide-webcil-graph.stamp">
    <RemoveDir Directories="$(IntermediateOutputPath)webcil" />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Touch Files="$(IntermediateOutputPath)carbide-webcil-graph.stamp" AlwaysCreate="true" />
    <Message Text="Carbide: package graph changed; dropped the Webcil conversion cache so the publish cannot carry assemblies from the previous graph."
             Importance="high" />
  </Target>

  <!--
    T3 — overlay Carbide's forked System.Console.dll on top of the stock one that the
    Mono-WASM publish pipeline drops into `_framework/`. Runs after Publish so the file we
    copy into survives; the loader picks up the fork (same assembly name, same TFM) at
    `dotnet.js` boot time because the loader trusts the file by name.

    We don't ProjectReference the fork — that would double-register the assembly in the
    Core build graph and confuse ref-pack resolution. Instead we build the fork
    out-of-band here and file-copy its output.
  -->
  <Target Name="CarbideBuildForkedSystemConsole" BeforeTargets="Publish">
    <!--
      Restore explicitly: a project driven through an MSBuild task call is not part of the
      entry project's implicit-restore graph, so a fresh clone would fail with NETSDK1004.
      Restore and Build must be separate task calls with different global-property sets —
      a combined Restore;Build reuses the pre-restore evaluation and cannot see the
      obj/*.props|targets that restore generates.
    -->
    <MSBuild Projects="..\..\core-bcl\System.Console\Carbide.System.Console.csproj"
             Properties="Configuration=$(Configuration)"
             Targets="Restore" />
    <MSBuild Projects="..\..\core-bcl\System.Console\Carbide.System.Console.csproj"
             Properties="Configuration=$(Configuration);CarbideExplicitlyRestored=true"
             Targets="Build" />
  </Target>
  <!--
    M8 — with Webcil on, the publish pipeline emits `System.Console.wasm` and no `.dll` at
    all, so the overlay has to write over the `.wasm` asset the boot config actually names.
    The bytes stay a plain PE: Mono's loader dispatches on the image's magic, not on the
    file extension, so a PE served under a `.wasm` name loads correctly. That keeps the
    overlay a file copy instead of requiring Carbide to re-implement the SDK's PE→Webcil
    conversion for a single assembly.
  -->
  <Target Name="CarbideOverlayForkedSystemConsole" AfterTargets="Publish">
    <PropertyGroup>
      <CarbideForkedConsoleDll>..\..\core-bcl\System.Console\bin\$(Configuration)\$(TargetFramework)\System.Console.dll</CarbideForkedConsoleDll>
      <CarbideFrameworkPublishDir>$(PublishDir)wwwroot\_framework\</CarbideFrameworkPublishDir>
      <CarbideStockConsoleAsset Condition="'$(WasmEnableWebcil)' == 'true'">System.Console.wasm</CarbideStockConsoleAsset>
      <CarbideStockConsoleAsset Condition="'$(CarbideStockConsoleAsset)' == ''">System.Console.dll</CarbideStockConsoleAsset>
    </PropertyGroup>
    <Error Condition="!Exists('$(CarbideForkedConsoleDll)')"
           Text="T3 overlay failed: forked System.Console.dll not found at $(CarbideForkedConsoleDll). Build Carbide.System.Console.csproj first." />
    <Error Condition="!Exists('$(CarbideFrameworkPublishDir)$(CarbideStockConsoleAsset)')"
           Text="T3 overlay failed: stock $(CarbideStockConsoleAsset) not found at $(CarbideFrameworkPublishDir). Did the Mono-WASM publish step run?" />
    <Copy SourceFiles="$(CarbideForkedConsoleDll)"
          DestinationFiles="$(CarbideFrameworkPublishDir)$(CarbideStockConsoleAsset)"
          OverwriteReadOnlyFiles="true"
          UseHardlinksIfPossible="false" />
    <Message Text="T3: overlaid forked System.Console into $(CarbideFrameworkPublishDir)$(CarbideStockConsoleAsset)" Importance="high" />
  </Target>
</Project>
