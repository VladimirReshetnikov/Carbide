{
    "name": "carbide-repo",
    "version": "0.0.0",
    "private": true,
    "description": "Repository-level dev tooling for Carbide. Not published; the shippable packages live under Carbide/packages and Carbide.UI/packages.",
    "type": "module",
    "scripts": {
        "lint": "eslint .",
        "check-licenses": "node scripts/check-licenses.mjs",
        "check-changelog": "node scripts/check-changelog.mjs",
        "check-wire-schema": "node scripts/check-wire-schema.mjs",
        "build:ts-packages": "node scripts/build-ts-packages.mjs",
        "api-surface": "node scripts/api-surface.mjs",
        "api-surface:write": "node scripts/api-surface.mjs --write",
        "check": "npm run check-licenses && npm run check-changelog && npm run check-wire-schema && npm run lint"
    },
    "devDependencies": {
        "@eslint/js": "^9.31.0",
        "eslint": "^9.31.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.36.0"
    }
}
